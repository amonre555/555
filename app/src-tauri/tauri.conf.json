{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "555",
  "identifier": "app.yato.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "555",
        "width": 1240,
        "height": 780,
        "minWidth": 880,
        "minHeight": 560,
        "backgroundColor": "#0c0c10"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: http://cover.localhost cover:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEzQkFFQ0FGQjY3MEQ2MDEKUldRQjFuQzJyK3k2bzJZblcwaW5WZjlQcm1LRHJWb1Z5NlFxUGJXN1pYQlZqWEI4OFpHMzRzU1kK",
      "endpoints": [
        "https://github.com/amonre555/555/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
